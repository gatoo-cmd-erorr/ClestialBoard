<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
        <layer-list>
            <!-- Dasar 3D tombol bata LEGO -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_lip" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <!-- Permukaan tombol chrome berkilau -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="@color/btn_mid"
                        android:endColor="@color/btn_bot"
                        android:startColor="@color/btn_top" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/btn_stroke" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
