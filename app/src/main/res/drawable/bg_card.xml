<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bibir bawah 3D balok LEGO -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bevel_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Permukaan atas balok LEGO berkilau chrome -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/card"
                android:endColor="@color/card_bottom"
                android:startColor="@color/card_top" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Garis kilap tepi atas -->
    <item
        android:bottom="4dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.75dp"
                android:color="#33FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
