<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <layer-list>
            <!-- Dasar stud bundar LEGO -->
            <item android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/bevel_dark" />
                </shape>
            </item>
            <!-- Permukaan stud chrome -->
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:centerColor="@color/card"
                        android:endColor="@color/card_bottom"
                        android:startColor="@color/card_top" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/line" />
                </shape>
            </item>
            <!-- Ring pantulan dalam khas stud LEGO -->
            <item
                android:bottom="5dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="0.75dp"
                        android:color="#38FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
