<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bibir baseplate nav -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bevel_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Baseplate dock LEGO -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/card"
                android:endColor="@color/card_bottom"
                android:startColor="@color/card_top" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
