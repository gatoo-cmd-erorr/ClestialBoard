<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ClestialHeaderTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ClestialSub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="ClestialTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ClestialDesc">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="ClestialCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">17dp</item>
    </style>

    <style name="ClestialBtn">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_inv</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ClestialPill">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <style name="ClestialCircleButton">
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/fg</item>
    </style>

</resources>
