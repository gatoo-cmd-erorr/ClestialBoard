<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_popup"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar: draggable + double tap to close -->
    <LinearLayout
        android:id="@+id/floatingHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFloatingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asisten Cepat (2x ketuk tutup)"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAntiDetectToggle"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_floating_pill_on"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:stateListAnimator="@null"
            android:text="Anti Detek"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFloatingClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_floating_pill"
            android:contentDescription="Tutup"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kb_close" />
    </LinearLayout>

    <!-- Navigasi Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_floating_tab"
            android:gravity="center"
            android:text="✨ Tanya AI"
            android:textColor="#F8FAFC"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabGoogle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_floating_tab"
            android:gravity="center"
            android:text="🔍 Google"
            android:textColor="#F8FAFC"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMath"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_floating_tab"
            android:gravity="center"
            android:text="∑ Kalkulator"
            android:textColor="#F8FAFC"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabAutoAnswer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.05"
            android:background="@drawable/bg_floating_tab"
            android:gravity="center"
            android:text="🎯 Auto ABCD"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Frame -->
    <FrameLayout
        android:id="@+id/floatingContentFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <!-- Tab 1: AI / ChatGPT -->
        <LinearLayout
            android:id="@+id/panelAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/etAiQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_floating_input"
                android:hint="Tulis pertanyaan atau soal cerita…"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAiPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:stateListAnimator="@null"
                    android:text="📋 Tempel"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAiClear"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:stateListAnimator="@null"
                    android:text="Hapus"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAiKeyToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:stateListAnimator="@null"
                    android:text="🔑 Key"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAiSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_floating_btn"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"
                    android:text="Tanya AI"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Panel Pengaturan Base URL, API Key & Model Inline -->
            <LinearLayout
                android:id="@+id/panelAiKeyConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_card"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etAiBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_floating_input"
                    android:hint="Base URL (mis. https://.../v1 atau http://ip:20128/v1)"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_floating_input"
                    android:hint="API Key (sk-... / gsk_... / sk-or-...)"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etAiModel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_floating_input"
                        android:hint="Model / Combo (mis. ag/gemini-3.8-flash-high)"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAiTestKey"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_floating_pill"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:stateListAnimator="@null"
                        android:text="Tes"
                        android:textAllCaps="false"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAiSaveKey"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_floating_btn"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@null"
                        android:text="Simpan"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/svAiResponse"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_floating_card"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvAiResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Hasil jawaban AI akan muncul di sini…"
                    android:textColor="#F1F5F9"
                    android:textIsSelectable="true"
                    android:textSize="12.5sp" />
            </ScrollView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAiCopy"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_pill"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="📋 Salin Jawaban AI"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Mini Google Search Webview -->
        <LinearLayout
            android:id="@+id/panelGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etGoogleQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_floating_input"
                    android:hint="Cari Google…"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#94A3B8"
                    android:textSize="12.5sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGoogleSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_floating_btn"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"
                    android:text="Cari"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Navigasi mini webview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWebBack"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="←"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWebReload"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="🔄"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWebUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="https://www.google.com"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <WebView
                android:id="@+id/wvGoogle"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp"
                android:background="#0B1120" />
        </LinearLayout>

        <!-- Tab 3: Kalkulator Umum/Kombinasi & SMP 9 Math Solver -->
        <LinearLayout
            android:id="@+id/panelMath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/mathChipsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvFloatingMathDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pilih mode kalkulator atau materi SMP 9:"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp" />

            <ScrollView
                android:id="@+id/svMathFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/mathFieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- Bilah Keypad Cepat (Multi-baris / Bisa ketik angka, kombinasi, fungsi, huruf tanpa keyboard sistem) -->
            <LinearLayout
                android:id="@+id/mathQuickKeypadBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_card"
                android:orientation="vertical"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKeypadPageNum"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_floating_pill_on"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:stateListAnimator="@null"
                        android:text="123 &amp; nCr"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKeypadPageSci"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_floating_pill"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:stateListAnimator="@null"
                        android:text="f(x) &amp; x/y"
                        android:textAllCaps="false"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKeypadPageAbc"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_floating_pill"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:stateListAnimator="@null"
                        android:text="ABC"
                        android:textAllCaps="false"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKeypadBack"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_floating_keypad_btn"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="⌫"
                        android:textAllCaps="false"
                        android:textColor="#FCA5A5"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKeypadClear"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_floating_keypad_btn"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="AC"
                        android:textAllCaps="false"
                        android:textColor="#FCA5A5"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mathQuickKeypadGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFloatingMathSolve"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Hitung Solusi Eksak"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/svMathResult"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_card"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvFloatingMathResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Jawaban dan langkah eksak akan tampil di sini…"
                    android:textColor="#F8FAFC"
                    android:textIsSelectable="true"
                    android:textSize="12.5sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFloatingMathExpand"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:stateListAnimator="@null"
                    android:text="🔍 Perbesar"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFloatingMathCopy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="📋 Salin Jawaban &amp; Langkah"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 4: Auto Jawab ABCD (Aplikasi & Layar Ujian) -->
        <LinearLayout
            android:id="@+id/panelAutoAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Status Banner Aksesibilitas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_floating_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvAutoAnswerAccStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Aksesibilitas: Belum Aktif"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOpenAccSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:stateListAnimator="@null"
                    android:text="Aktifkan Izin"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Baris 3: Toggle Otomatis Pindai Layar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Otomatis Pindai Layar"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoAnswerEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Baris 4: Dua tombol mode Auto-Klik Layar vs Kunci & Salin Saja -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeAutoClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_floating_pill_on"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="Auto-Klik Layar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeKeyOnly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_floating_pill"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="Kunci &amp; Salin Saja"
                    android:textAllCaps="false"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Baris 5: Pilihan Jeda Klik (0s, 1.5s, 2s, 3s, Acak 20s - 3m) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jeda Klik:"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDelay0"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_floating_pill"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="7dp"
                            android:stateListAnimator="@null"
                            android:text="0s"
                            android:textAllCaps="false"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDelay1"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_floating_pill_on"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="7dp"
                            android:stateListAnimator="@null"
                            android:text="1.5s"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDelay2"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_floating_pill"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="7dp"
                            android:stateListAnimator="@null"
                            android:text="2s"
                            android:textAllCaps="false"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDelay3"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_floating_pill"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="7dp"
                            android:stateListAnimator="@null"
                            android:text="3s"
                            android:textAllCaps="false"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDelayRandom"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_floating_pill"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="8dp"
                            android:stateListAnimator="@null"
                            android:text="Acak (20s - 3m)"
                            android:textAllCaps="false"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Baris 6: Tombol Aksi Langsung -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTriggerScreenAnswer"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_floating_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="⚡ Pindai &amp; Proses Layar Sekarang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Baris 7: TextView Status -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_card"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvAutoAnswerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Siap mendeteksi soal ABCD di layar."
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp" />
            </ScrollView>

            <!-- Baris 8: Tombol Salin Hasil & Penjelasan -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopyAutoAnswer"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_pill"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="📋 Salin Hasil &amp; Penjelasan"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
