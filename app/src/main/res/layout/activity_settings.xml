<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header: tombol kembali bulat + judul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/ClestialCircleButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/ClestialHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/title_settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/ClestialSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="14dp"
                android:text="@string/sub_settings" />

            <!-- Tentang -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ClestialTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_title" />

                    <TextView
                        android:id="@+id/aboutVersion"
                        style="@style/ClestialDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/muted" />
            </LinearLayout>

            <!-- Konfigurasi AI & Base URL Dinamis (9router / OpenAI / Groq) -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ClestialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_cfg_card_title" />

                <TextView
                    style="@style/ClestialDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ubah Base URL (mis. tunnel 9router), API Key, dan Model secara dinamis tanpa rebuild." />

                <TextView
                    style="@style/ClestialDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ai_cfg_base_url_title" />

                <EditText
                    android:id="@+id/etSettingsBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_opt"
                    android:hint="@string/ai_cfg_base_url_hint"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    style="@style/ClestialDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ai_cfg_api_key_title" />

                <EditText
                    android:id="@+id/etSettingsApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_opt"
                    android:hint="@string/ai_cfg_api_key_hint"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    style="@style/ClestialDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ai_cfg_model_title" />

                <EditText
                    android:id="@+id/etSettingsModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_opt"
                    android:hint="@string/ai_cfg_model_hint"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSettingsResetAi"
                        style="@style/ClestialPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:text="@string/ai_cfg_reset"
                        android:textColor="@color/fg" />

                    <TextView
                        android:id="@+id/btnSettingsTestAi"
                        style="@style/ClestialPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:text="@string/ai_cfg_test"
                        android:textColor="@color/fg" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnSettingsSaveAi"
                        style="@style/ClestialBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_cfg_save" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSettingsAiStatus"
                    style="@style/ClestialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
