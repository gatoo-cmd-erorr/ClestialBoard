<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/ClestialCircleButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/ClestialHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/math_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/ClestialSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/math_sub" />

            <!-- Bagian Soal Cerita AI (9router) -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ClestialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/math_story_title" />

                <EditText
                    android:id="@+id/etStory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:hint="@string/math_story_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="68dp"
                    android:padding="12dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnParseStory"
                    style="@style/ClestialBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/math_story_parse" />

                <TextView
                    android:id="@+id/tvStoryStatus"
                    style="@style/ClestialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <!-- Kotak konfirmasi tafsiran AI sebelum solver menghitung -->
                <LinearLayout
                    android:id="@+id/storyConfirmBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvStoryPreview"
                        style="@style/ClestialTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnConfirmStory"
                            style="@style/ClestialBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/math_story_confirm" />

                        <TextView
                            android:id="@+id/btnEditStory"
                            style="@style/ClestialBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_done"
                            android:text="@string/math_story_edit"
                            android:textColor="@color/fg" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Daftar pilihan materi dikelompokkan (Aljabar, Geometri, Statistika & Peluang) -->
            <LinearLayout
                android:id="@+id/moduleMenuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Formulir input modul aktif -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveModuleTitle"
                    style="@style/ClestialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvActiveModuleDesc"
                    style="@style/ClestialDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/fieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnSolve"
                    style="@style/ClestialBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/math_solve_btn" />
            </LinearLayout>

            <!-- Kartu Hasil Solver + Cek + Penjelasan AI -->
            <LinearLayout
                android:id="@+id/resultCard"
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResultHeader"
                    style="@style/ClestialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvResultAnswer"
                    style="@style/ClestialTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <com.clestial.keyboard.math.LineSketchView
                    android:id="@+id/lineSketchView"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvResultSteps"
                    style="@style/ClestialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvResultCheck"
                    style="@style/ClestialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCopyResult"
                        style="@style/ClestialBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_done"
                        android:text="@string/math_copy_btn"
                        android:textColor="@color/fg" />

                    <TextView
                        android:id="@+id/btnExplainAi"
                        style="@style/ClestialBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/math_explain_btn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAiExplain"
                    style="@style/ClestialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Kartu Rumus Materi -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ClestialTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/math_formula_title" />

                    <TextView
                        android:id="@+id/btnToggleAllFormulas"
                        style="@style/ClestialBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_done"
                        android:text="@string/math_formula_show_all"
                        android:textColor="@color/fg"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/formulaListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Pengaturan Proxy 9router -->
            <LinearLayout
                style="@style/ClestialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ClestialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/math_proxy_label" />

                <EditText
                    android:id="@+id/etProxyUrl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSaveProxy"
                    style="@style/ClestialBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/math_proxy_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
