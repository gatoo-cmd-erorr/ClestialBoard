<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSelectionBox"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Kotak Seleksi Bergaris Biru Neon (Foto 2) -->
    <FrameLayout
        android:id="@+id/boxFrame"
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_selection_box"
        android:clickable="true"
        android:focusable="true">

        <!-- Teks petunjuk halus di dalam kotak -->
        <TextView
            android:id="@+id/tvBoxHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="8dp"
            android:text="Pas kan kotak ke soal"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Pegangan pengubah ukuran di sudut kanan bawah -->
        <ImageView
            android:id="@+id/ivResizeHandle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:contentDescription="Ubah Ukuran"
            android:padding="4dp"
            android:src="@drawable/ic_kb_resize" />
    </FrameLayout>

    <!-- Tombol Aksi Bawah: Batal [✕] dan Selesai/Pindai [✓] -->
    <LinearLayout
        android:id="@+id/boxButtonBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCropCancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_cancel"
            android:contentDescription="Batal"
            android:elevation="4dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kb_close" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnCropConfirm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_confirm"
            android:contentDescription="Pindai Soal &amp; Buka Google"
            android:elevation="4dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kb_check" />
    </LinearLayout>

</LinearLayout>
